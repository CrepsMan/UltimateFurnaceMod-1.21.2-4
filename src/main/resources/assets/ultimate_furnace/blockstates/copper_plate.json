{
  "multipart": [
    { "when": { "hot": "true" }, "apply": { "model": "ultimate_furnace:block/copper_plate_hot" } },
    { "when": { "hot": "false", "cold": "true" }, "apply": { "model": "ultimate_furnace:block/copper_plate_cold" } },
    { "when": { "hot": "false", "cold": "false" }, "apply": { "model": "ultimate_furnace:block/copper_plate" } }
  ]
}
